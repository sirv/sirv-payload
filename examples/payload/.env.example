# Copy to .env and fill in. Never commit real secrets.

# Required: Payload uses this to sign cookies AND (via the plugin) to encrypt the Sirv secret.
PAYLOAD_SECRET=change-me-to-a-long-random-string

# SQLite database location (default: local file).
DATABASE_URI=file:./payload.db

# Sirv credentials are NOT set here. Connect your account in the admin at /admin/sirv
# (paste REST Client ID + Secret). They are stored encrypted in the sirv-settings global.
