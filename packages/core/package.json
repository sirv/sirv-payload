{
  "name": "@sirv/core",
  "version": "0.0.0",
  "description": "Host-agnostic Sirv DAM hooks (clientId/secret auth, folders, search, type filters), asset types and Zod schemas. Contains ZERO Sanity code.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
